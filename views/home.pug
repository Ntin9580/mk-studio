extends layout
block content
  section.hero
    img.hero-img(src="https://www.newjerseyvideography.com/wp-content/uploads/2018/01/DS1_9589.jpg",alt="Wedding photography")
    .hero-overlay
    .hero-copy
      p.eyebrow Editorial photography · India
      h1 Moments that<br><em>feel like you.</em>
      p.hero-sub Photographs that feel honest today and meaningful years from now.
      a.btn.btn-light(href="/portfolio") Explore portfolio
  section.section
    p.section-kicker 
    .intro-grid
      h2 A visual signature<br><em>built around you.</em>
      p We work quietly inside your story — anticipating the honest glances, movement and details that make your photographs yours.
  section.section.featured
    .section-head
      p.section-kicker 
      a.under-link(href="/portfolio") View all →
    .mosaic
      img(src="https://wallpaperaccess.com/full/229799.jpg")
      img(src="https://i.pinimg.com/736x/bf/ac/d2/bfacd28ff6db3f0268787f3500c8e935.jpg")
      img(src="https://wallpaperaccess.com/full/2340886.jpg")
  section.section.wa-section
    .wa-card
      p.section-kicker 
      h2 Let's make it<br><em>official.</em>
      p Tell us your shoot type, date and location. The message opens directly in WhatsApp.
      a.btn.btn-light(href="https://wa.me/917376426350?text=Hi%20MK%20Photography%2C%20I%27d%20like%20to%20enquire.%0AType%3A%20%0ADate%3A%20%0ALocation%3A",target="_blank") Start WhatsApp enquiry
  section.section
    p.section-kicker Packages
    .package-grid
      article
        h3 Essential
        p From ₹8,000
      article
        h3 Signature
        p From ₹25,000
      article
        h3 Editorial
        p Custom quote
  section.section.cta
    h2 Your story deserves<br><em>more than a gallery.</em>
    a.btn(href="/contact#booking") Plan your shoot
