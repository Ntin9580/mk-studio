extends layout
block content
  section.page-hero
    p.eyebrow 02 / Portfolio
    h1 The work.<br><em>The feeling behind it.</em>
  section.section
    .filter-bar
      button.filter-btn.active(data-filter="all") All
      button.filter-btn(data-filter="wedding") Weddings
      button.filter-btn(data-filter="portrait") Portraits
      button.filter-btn(data-filter="editorial") Editorial
    .portfolio-grid
      - const items=[['wedding','https://images.unsplash.com/photo-1511285560929-80b456fea0bc?auto=format&fit=crop&w=1100&q=86'],['portrait','https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=1100&q=86'],['editorial','https://images.unsplash.com/photo-1483985988355-763728e1935b?auto=format&fit=crop&w=1100&q=86'],['wedding','https://images.unsplash.com/photo-1465495976277-4387d4b0e4a6?auto=format&fit=crop&w=1100&q=86']]
      each item in items
        .portfolio-item(data-category=item[0])
          img(src=item[1],alt=item[0],loading="lazy")
  section.section.cta
    h2 Like what you see?<br><em>Let's plan yours.</em>
    a.btn(href="/contact#booking") Enquire now
